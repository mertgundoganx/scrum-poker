# Copy to .env and fill in. `pnpm dev` and `pnpm start` read .env; so does
# `docker run --env-file .env`, which takes every value literally: no quotes
# and no comments after a value.

# ── Required ──────────────────────────────────────────────────────────────
# Signs the per-room identity cookies; 32 characters or more. Generate one with
#   openssl rand -base64 32
# or, without OpenSSL:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Without it nobody can create or join a room.
ROOM_TOKEN_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# Redis: room snapshots survive a restart and kept rooms are stored there.
# Without it rooms and kept rooms live in the process's memory only and end
# with it. Rate limits are in memory either way. Inside Docker, localhost is
# the container itself: use the Redis host's name or address.
# REDIS_URL=redis://localhost:6379

# Log level: trace, debug, info, warn or error (default: info in production,
# debug otherwise).
# LOG_LEVEL=info
